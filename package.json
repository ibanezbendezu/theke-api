{
  "name": "theke-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:infra": "docker compose -f compose.dev.yml up -d",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/apply-migrations.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "contracts:generate": "node scripts/generate-contract-manifest.mjs",
    "contracts:check": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@clerk/backend": "3.18.1",
    "@fastify/cors": "11.1.0",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-fastify": "12.0.4",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pg-boss": "12.33.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.16.0",
    "eslint": "10.8.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "5.0.1"
  }
}
